{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable",
  "effortLevel": "xhigh",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)"
    ],
    "allow": [
      "Bash(corepack enable)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm type-check)",
      "Bash(pnpm prisma:generate)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Read(./**)",
      "Write(./src/**)",
      "Write(./messages/**)",
      "Write(./prisma/**)",
      "Skill"
    ]
  }
}
