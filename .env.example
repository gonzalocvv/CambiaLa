# =====================================================
# .env.example — Variables de entorno requeridas
# =====================================================
# Copiar a .env.local y llenar con valores reales.
# Las credenciales reales NUNCA se commitean.
# Pedir los valores actuales al equipo (Discord/WhatsApp).
# =====================================================

# ---- Supabase ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SERVICE ROLE KEY: solo backend, NUNCA exponer al cliente.
# Bypass de RLS. Mantener segura.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- Database (Prisma) ----
# Pooled connection para queries en API routes
DATABASE_URL="postgresql://postgres.xxxxx:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection para migrations
DIRECT_URL="postgresql://postgres.xxxxx:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ---- Email (Resend) ----
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="hola@figus.uy"

# ---- App ----
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# En producción: https://figus.uy

# ---- Monitoring ----
# Sentry: para errores. Crear proyecto en sentry.io.
SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
SENTRY_ORG="figus-uy"
SENTRY_PROJECT="frontend"
SENTRY_AUTH_TOKEN=""

# PostHog: para analytics y feature flags.
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# ---- Inngest ----
# Jobs en background (matchmaking, notificaciones).
INNGEST_SIGNING_KEY="signkey-xxxxx"
INNGEST_EVENT_KEY="xxxxx"

# ---- Admin ----
# Lista separada por coma de user IDs con rol admin.
# Se setea manualmente después del primer registro.
ADMIN_USER_IDS=""

# ---- Web Push (F2 — descomentar cuando se implemente) ----
# VAPID keys: generar con `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=""
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# ---- Mercado Pago (F2 — Plan Pro) ----
# MERCADO_PAGO_ACCESS_TOKEN=""
# MERCADO_PAGO_PUBLIC_KEY=""
# MERCADO_PAGO_WEBHOOK_SECRET=""

# ---- Google OAuth ----
# Se configura en Supabase Auth → Providers → Google.
# No hace falta credenciales adicionales acá si se usa el flow de Supabase.

# ---- Feature flags ----
# NEXT_PUBLIC_ENABLE_WEB_PUSH="false"
# NEXT_PUBLIC_ENABLE_REALTIME_CHAT="false"
# NEXT_PUBLIC_ENABLE_VERIFICATION="false"
